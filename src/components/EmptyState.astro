---
interface Props {
  title: string;
  message: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, message, actionHref, actionLabel } = Astro.props;
---

<div class="empty-state" role="status">
  <span class="empty-icon" aria-hidden="true">↗</span>
  <div>
    <h2>{title}</h2>
    <p>{message}</p>
    {
      actionHref && actionLabel && (
        <a class="text-link" href={actionHref}>
          {actionLabel}
        </a>
      )
    }
  </div>
</div>
