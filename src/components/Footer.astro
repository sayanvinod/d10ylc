---
import { contactEmail } from '../content/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-lead">
      <p class="eyebrow">District 10 youth, in action</p>
      <h2>Make your voice part of what comes next.</h2>
      <a class="button button-light" href="/join/">Explore how to join</a>
    </div>
    <div class="footer-links">
      <div>
        <h3>Explore</h3>
        <a href="/about/">About</a>
        <a href="/impact/">Our Impact</a>
        <a href="/events/">Events & Opportunities</a>
        <a href="/meetings/">Meetings & Resources</a>
      </div>
      <div>
        <h3>Site information</h3>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
        <a href="/accessibility/">Accessibility</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {year} District 10 Youth Leadership Coalition</p>
    <p>
      Official email:
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
  </div>
</footer>
