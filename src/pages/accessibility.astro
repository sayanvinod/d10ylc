---
import PageIntro from '../components/PageIntro.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Accessibility"
  description="Read D10YLC's accessibility approach and how to report a barrier."
>
  <PageIntro
    eyebrow="Accessibility"
    title="Accessibility"
    intro="D10YLC aims to make this website usable for the widest possible range of people and technologies."
  />

  <section class="section">
    <div class="narrow prose">
      <h2>Our target</h2>
      <p>
        The site is built toward Web Content Accessibility Guidelines (WCAG) 2.2
        Level AA. It uses semantic headings and landmarks, keyboard-operable
        navigation, visible focus, high-contrast text, responsive reflow, and
        reduced-motion support.
      </p>

      <h2>Documents and third-party services</h2>
      <p>
        Public resources should include descriptive names and accessible HTML
        context. Any future external application or registration service must be
        reviewed for keyboard, screen-reader, error-message, and mobile usability.
      </p>

      <h2>Report a barrier</h2>
      <p>
        An accessibility contact is being confirmed. When published on the
        <a href="/contact/">Contact page</a>, please include the page address,
        what you were trying to do, and the assistive technology or browser used
        if you are comfortable sharing it.
      </p>
    </div>
  </section>
</SiteLayout>
