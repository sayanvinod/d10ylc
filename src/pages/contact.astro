---
import PageIntro from '../components/PageIntro.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { contactEmail } from '../content/site';
---

<SiteLayout
  title="Contact"
  description="Find safe, current guidance for contacting the District 10 Youth Leadership Coalition."
>
  <PageIntro
    eyebrow="Contact"
    title="Contact D10YLC"
    intro="Email the District 10 Youth Leadership Coalition with questions about membership, referrals, partnerships, or this website."
  />

  <section class="section">
    <div class="narrow prose">
      <h2>Email D10YLC</h2>
      <p>
        The official contact email is
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
      </p>
      <p>
        <a class="button" href={`mailto:${contactEmail}`}>Email us</a>
      </p>
      <p>
        Please do not include sensitive student, applicant, or private meeting
        information in email.
      </p>
    </div>
  </section>
</SiteLayout>
