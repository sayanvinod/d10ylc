---
import PageIntro from '../components/PageIntro.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Contact"
  description="Find safe, current guidance for contacting the District 10 Youth Leadership Coalition."
>
  <PageIntro
    eyebrow="Contact"
    title="Contact D10YLC"
    intro="The official monitored contact channel is being confirmed before it is published here."
  />

  <section class="section">
    <div class="narrow prose">
      <div class="notice">
        <strong>Contact verification in progress</strong>
        Older D10YLC pages list multiple addresses and contacts. This site does
        not repeat one until the responsible organization owner confirms who
        monitors it and what kinds of messages it may receive.
      </div>
      <h2>When contact is available</h2>
      <p>
        This page will provide separate, clear guidance for membership
        questions, school or community referrals, partnerships, and website
        accessibility. Do not include sensitive student, applicant, or meeting
        information in an unverified channel.
      </p>
    </div>
  </section>
</SiteLayout>
