---
import EmptyState from '../components/EmptyState.astro';
import PageIntro from '../components/PageIntro.astro';
import { getPublishedImpact, impactStories } from '../content/impact';
import SiteLayout from '../layouts/SiteLayout.astro';

const stories = getPublishedImpact(impactStories);
---

<SiteLayout
  title="Our Impact"
  description="See verified stories of D10YLC policy, service, events, and workshops."
>
  <PageIntro
    eyebrow="Our impact"
    title="Our impact"
    intro="Explore current D10YLC initiatives alongside documented historical projects, service, events, and workshops."
  />

  <section class="section">
    <div class="content-shell">
      {
        stories.length === 0 ? (
          <EmptyState
            title="Verified stories are being prepared"
            message="Past activities are being checked for dates, outcomes, partner attribution, and permission to publish. Stories will appear here only when that record is complete."
            actionHref="/about/"
            actionLabel="Learn how D10YLC works"
          />
        ) : (
          <div class="card-grid">
            {stories.map((story) => (
              <article class="card impact-card">
                {story.imageSrc && story.imageAlt && (
                  <img
                    class="impact-image"
                    src={story.imageSrc}
                    alt={story.imageAlt}
                    width="600"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="tag">{story.category}</span>
                <p
                  class:list={[
                    'impact-period',
                    { 'impact-period-current': story.status === 'ongoing' },
                  ]}
                >
                  {
                    story.status === 'ongoing'
                      ? 'Current ongoing initiative'
                      : 'Historical project'
                  }
                </p>
                <h2>{story.title}</h2>
                {story.date && (
                  <p>
                    <time datetime={story.date}>
                      {new Date(story.date).toLocaleDateString('en-US', {
                        dateStyle: 'long',
                      })}
                    </time>
                  </p>
                )}
                {story.communityNeed && (
                  <p>
                    <strong>Community need:</strong> {story.communityNeed}
                  </p>
                )}
                <p>{story.summary}</p>
                {story.result && (
                  <p>
                    <strong>Result:</strong> {story.result}
                  </p>
                )}
                {story.partners && story.partners.length > 0 && (
                  <p>
                    <strong>Partners:</strong> {story.partners.join(', ')}
                  </p>
                )}
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</SiteLayout>
