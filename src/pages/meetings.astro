---
import EmptyState from '../components/EmptyState.astro';
import PageIntro from '../components/PageIntro.astro';
import { getPublicResources, resources } from '../content/resources';
import SiteLayout from '../layouts/SiteLayout.astro';

const publicResources = getPublicResources(resources);
---

<SiteLayout
  title="Meetings & Resources"
  description="Find approved public D10YLC meeting agendas, minutes, presentations, and reports."
>
  <PageIntro
    eyebrow="Meetings & resources"
    title="Meetings & resources"
    intro="A public library for approved agendas, minutes, presentations, and reports—without private meeting or student information."
  />

  <section class="section">
    <div class="content-shell">
      {
        publicResources.length === 0 ? (
          <EmptyState
            title="No public meeting resources are published"
            message="The team has not yet confirmed which meeting materials are approved for public access. Private links, attendance details, and internal notes will never be posted here."
            actionHref="/contact/"
            actionLabel="Read contact guidance"
          />
        ) : (
          <div class="card-grid">
            {publicResources.map((resource) => (
              <article class="card">
                <span class="tag">{resource.kind}</span>
                <h2>{resource.title}</h2>
                <p>
                  <time datetime={resource.meetingDate}>
                    {new Date(resource.meetingDate).toLocaleDateString('en-US', {
                      dateStyle: 'long',
                    })}
                  </time>
                </p>
                <p>{resource.summary}</p>
                <a class="text-link" href={resource.url}>
                  Open {resource.kind.toLowerCase()}
                </a>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-mint">
    <div class="narrow prose">
      <p class="eyebrow">Public by design</p>
      <h2>Useful records, protected participants.</h2>
      <p>
        Public resources use descriptive titles and accessible summaries.
        Member-only material stays in an approved private system; this site will
        not expose internal joining links, attendance, contact details, or notes.
      </p>
    </div>
  </section>
</SiteLayout>
