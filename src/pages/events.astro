---
import EmptyState from '../components/EmptyState.astro';
import PageIntro from '../components/PageIntro.astro';
import {
  events,
  getActiveEvents,
  officialCalendarUrl,
} from '../content/events';
import SiteLayout from '../layouts/SiteLayout.astro';

const activeEvents = getActiveEvents(events);
---

<SiteLayout
  title="Events & Opportunities"
  description="Find current D10YLC events, volunteer activities, and verified external opportunities."
>
  <PageIntro
    eyebrow="Events & opportunities"
    title="Events & opportunities"
    intro="Use the official D10YLC calendar for the latest schedule, plus verified listings with dates and details checked for publication."
  />

  <section class="section">
    <div class="content-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Official calendar</p>
          <h2>See what’s on the calendar.</h2>
        </div>
        <p>
          Calendar entries are maintained in Google Calendar. Open an entry
          there for its latest available details.
        </p>
      </div>
      <div class="calendar-frame">
        <iframe
          src={officialCalendarUrl}
          title="D10YLC official Google Calendar"
          loading="lazy"
          referrerpolicy="no-referrer"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
        ></iframe>
      </div>
      <div class="calendar-support">
        <p>
          Calendar not loading? <a
            class="text-link"
            href={officialCalendarUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open the D10YLC calendar
          </a>.
        </p>
        <p class="calendar-privacy">
          The embedded calendar is provided by Google. Loading it sends
          technical request information to Google under its policies.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-mint">
    <div class="content-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Verified listings</p>
          <h2>Current events and opportunities</h2>
        </div>
        <p>
          Detailed listings appear here only after their dates, eligibility,
          source, and registration path are verified.
        </p>
      </div>
      {
        activeEvents.length === 0 ? (
          <EmptyState
            title="No current listings are published"
            message="No event or opportunity has a fully verified date, eligibility rule, source, and registration path right now. Closed or outdated listings are not shown as upcoming."
            actionHref="/join/"
            actionLabel="Explore D10YLC membership"
          />
        ) : (
          <div class="card-grid">
            {activeEvents.map((event) => (
              <article class="card">
                <span class="tag">{event.type}</span>
                <h2>{event.title}</h2>
                <p>
                  <strong>When:</strong>{' '}
                  <time datetime={event.startsAt}>
                    {new Date(event.startsAt).toLocaleDateString('en-US', {
                      dateStyle: 'long',
                    })}
                  </time>
                </p>
                <p>
                  <strong>Where:</strong> {event.location}
                </p>
                <p>
                  <strong>Eligibility:</strong> {event.eligibility}
                </p>
                <p>
                  <strong>Registration deadline:</strong>{' '}
                  {
                    event.registrationDeadline ? (
                      <time datetime={event.registrationDeadline}>
                        {new Date(event.registrationDeadline).toLocaleDateString(
                          'en-US',
                          { dateStyle: 'long' },
                        )}
                      </time>
                    ) : (
                      'No registration deadline'
                    )
                  }
                </p>
                <p>
                  <strong>Listing owner:</strong> {event.owner}
                </p>
                <a class="text-link" href={event.sourceUrl}>
                  {event.sourceLabel}
                </a>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-teal">
    <div class="narrow prose">
      <p class="eyebrow">How listings work</p>
      <h2>Current means checked.</h2>
      <p>
        Each listing needs an owner, source, date, deadline, eligibility,
        location, and expiration date. External programs appear only when the
        current cycle is confirmed on an official source.
      </p>
    </div>
  </section>
</SiteLayout>
